# Application Environment
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Machine Learning Model Checkpoints
# Set relative to repository root or provide absolute paths
MODEL1_PATH=best_heavy_rain_xgboost_v2.json
MODEL2_PATH=best_model.pth

# NASA POWER Meteorological API
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIMEOUT_SECONDS=30.0
NASA_POWER_MAX_RETRIES=3

# Numerical Weather Prediction (NWP) - Open-Meteo GFS API
NWP_BASE_URL=https://api.open-meteo.com/v1/forecast
NWP_MODEL=gfs_seamless
NWP_TIMEOUT_SECONDS=30.0
NWP_MAX_RETRIES=3

# Doppler Weather Radar (DWR) - RainViewer Global Radar Composite API
RADAR_BASE_URL=https://api.rainviewer.com/public/weather-maps.json
RADAR_TILE_BASE_URL=https://tilecache.rainviewer.com
RADAR_TIMEOUT_SECONDS=30.0
RADAR_MAX_RETRIES=3

# Data Cache Directory
DATA_CACHE_DIR=data_cache

# Security & CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

